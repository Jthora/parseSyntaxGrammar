{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuantumGrammarLexiconEntry",
  "type": "object",
  "required": ["token", "candidates"],
  "properties": {
    "token": { "type": "string", "description": "Lowercased surface form" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "integer", "minimum": 0, "maximum": 9 },
          "weight": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "morphological": {
      "type": "object",
      "properties": {
        "suffixes": { "type": "array", "items": { "type": "string" } },
        "prefixes": { "type": "array", "items": { "type": "string" } },
        "is_plural": { "type": "boolean" },
        "is_past": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "properties": {
        "time_marker": { "type": "boolean" },
        "positional": { "type": "boolean" },
        "article_like": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": { "type": "string" },
    "added_by": { "type": "string" },
    "added_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
